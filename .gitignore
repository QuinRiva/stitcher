# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/
.installed.cfg

# Virtualenvs / package managers
.venv/
venv/
env/
.python-version
poetry.lock
uv.lock

# Test / coverage / cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# IDE / OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Agent state — never push
.pi/
.claude/
.agents/
.roo/
AGENTS.md.local

# ---------------------------------------------------------------------------
# Anti-leak safety net: never commit anything that looks like internal data.
# These patterns exist to catch accidental copy-paste from internal projects.
# If you genuinely need a file matching these names, rename it.
# ---------------------------------------------------------------------------

# Internal artefacts — drafts, scratch, private notes
scratch/
private/
internal/
drafts/

# Loose session scratch — presentation notes, research dumps, review drafts
.presentation-*.md
.review-*.md
context.md
research.md
fix_slides.py
*.private.*
*.internal.*
*.confidential.*

# Fixtures and trace dumps that may carry production data
fixtures/
results/
*.trace.json
*.langfuse.json
*_trace_*.json
trace_*.json

# (anti-leak tripwires intentionally not enumerated here — they were
# more harm than help: broad globs caught legitimate filenames like
# 'release_notes.md', and the tripwire file itself ended up tracked,
# leaking the very words it was trying to ban. Rely on review instead.)
